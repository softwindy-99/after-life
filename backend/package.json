{
  "name": "after-life-backend",
  "version": "1.0.0",
  "description": "After Life NestJS API",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node ../scripts/run-env.mjs dev node node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "node ../scripts/run-env.mjs pro node node_modules/@nestjs/cli/bin/nest.js build",
    "start": "node ../scripts/run-env.mjs test node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "jest --config test/jest-unit.config.json --coverage --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "db": "ts-node -r tsconfig-paths/register src/setup/database.cli.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "test:mysql": "node test/letter-review.mysql.mjs",
    "start:pro": "node ../scripts/run-env.mjs pro node dist/main"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.2",
    "ali-oss": "^6.23.0",
    "dotenv": "16.4.1",
    "mysql2": "^3.9.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sanitize-html": "2.17.7",
    "typeorm": "^0.3.20",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/ali-oss": "^6.23.4",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.15",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.5.0",
    "prettier": "3.2.5",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
