{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": "<rootDir>/../test/esm-js-transform.cjs"
  },
  "transformIgnorePatterns": [
    "<rootDir>/../node_modules/(?!sanitize-html/node_modules/(htmlparser2|domhandler|domutils|domelementtype|entities)/)"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/$1"
  },
  "collectCoverageFrom": ["**/*.(t|j)s"],
  "coverageDirectory": "../coverage",
  "coverageThreshold": {
    "global": {
      "branches": 50,
      "functions": 60,
      "lines": 60,
      "statements": 60
    }
  },
  "testEnvironment": "node"
}
