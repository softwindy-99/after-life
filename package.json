{
  "name": "after-life",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bootstrap": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --prefix backend run build",
    "build:web": "npm --prefix frontend run build",
    "start": "node scripts/dev.mjs --built",
    "start:api": "npm --prefix backend start",
    "start:web": "npm --prefix frontend start",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --prefix backend test --",
    "posttest": "npm run test:cli",
    "test:cli": "node --test backend/test/agent-cli.test.mjs backend/test/environment.test.mjs",
    "test:e2e": "npm --prefix backend run test:e2e --",
    "check": "npm run lint && npm run format:check && npm test && npm run test:e2e && npm run test:web && npm run build",
    "db": "npm --prefix backend run db --",
    "typeorm": "npm --prefix backend run typeorm --",
    "test:web": "npm --prefix frontend test",
    "test:mysql": "npm run build:api && npm --prefix backend run test:mysql",
    "start:pro": "node scripts/dev.mjs --built --pro",
    "start:api:pro": "npm --prefix backend run start:pro",
    "start:web:pro": "npm --prefix frontend run start:pro"
  },
  "devDependencies": {
    "prettier": "3.2.5"
  },
  "author": {
    "name": "softwindy",
    "email": "softwindy@outlook.com"
  },
  "contributors": [
    {
      "name": "OpenAI Codex (AI-assisted development)"
    }
  ],
  "license": "Apache-2.0"
}
