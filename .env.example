# API、数据库 CLI 和前端共用根目录 .env。API 启动时按此示例补齐缺项。
# The API, database CLI and frontend share the root .env file. API startup fills missing keys from this template.
# Compose 的 AFTER_LIFE_PORT 控制宿主机端口。 / Compose uses AFTER_LIFE_PORT for the host port.

# API 监听端口 / API listening port
PORT=3000

# MySQL 连接；密码必填，不要提交真实凭据。 / MySQL connection; password required. Never commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=after_life

# 安装向导自动生成；手工配置时请在 .env 中填写稳定的签名密钥。
# Generated by setup; provide a stable signing secret in .env for manual configuration.
JWT_SECRET=

# 首次安装或数据库 CLI 的管理员信息；安装后不将账号密码写回文件。
# Administrator for first setup or database CLI; setup does not persist the account password.
INIT_ADMIN_USERNAME=Admin
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=

# SMTP 可稍后在界面配置；未配置时不发送邮件。 / SMTP can be configured later in the UI; no email is sent until configured.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SECURE=false

# 调度间隔（毫秒）和已投递信件保留期（天）。 / Scheduler intervals (milliseconds) and delivered-letter retention (days).
LETTER_STATUS_CHECK_INTERVAL_MS=60000
NOTIFICATION_CHECK_INTERVAL_MS=60000
DELIVERED_LETTER_RETENTION_DAYS=30

# Web Push 公私钥由安装向导生成；私钥必须保密。 / Setup generates Web Push keys; keep the private key secret.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# VAPID 联系地址，例如 mailto:owner@example.com；留空使用初始管理员邮箱。
# VAPID contact, e.g. mailto:owner@example.com; defaults to the initial administrator email.
WEB_PUSH_SUBJECT=
# 可选 HTTP/HTTPS 推送代理；留空回退到 .env 中的 HTTPS_PROXY / https_proxy。
# Optional HTTP/HTTPS push proxy; falls back to HTTPS_PROXY / https_proxy from .env when empty.
WEB_PUSH_PROXY=

# 允许调用 /mcp 的浏览器 Origin，逗号分隔并精确匹配；原生客户端通常无需设置。
# Exact browser Origins allowed for /mcp, comma-separated; native clients usually need none.
MCP_ALLOWED_ORIGINS=
# 公网 HTTPS API 地址，邮件资源链接使用；同源代理示例 https://example.com/api。
# Public HTTPS API URL for email resource links, e.g. https://example.com/api behind a same-origin proxy.
PUBLIC_BASE_URL=

# 私有附件存储：local（默认）、s3（含 MinIO）或 oss（阿里云）。
# Private attachment storage: local (default), s3 (including MinIO), or oss (Alibaba Cloud).
# 本地目录留空默认 backend/.codex/resources。 / Local directory defaults to backend/.codex/resources.
RESOURCE_STORAGE_DIR=
RESOURCE_STORAGE_DRIVER=local
# 先创建私有桶；存储凭据仅在服务端使用。 / Create a private bucket first; credentials remain server-side.
RESOURCE_STORAGE_ENDPOINT=
RESOURCE_STORAGE_REGION=
RESOURCE_STORAGE_BUCKET=
RESOURCE_STORAGE_PREFIX=after-life
RESOURCE_STORAGE_FORCE_PATH_STYLE=true
RESOURCE_STORAGE_ACCESS_KEY_ID=
RESOURCE_STORAGE_ACCESS_KEY_SECRET=

# 版本标识可选；留空使用服务端默认值。 / Optional version metadata; empty values use server defaults.
SERVER_VERSION=
SUPPORTED_CLIENT_VERSION_MIN=
SUPPORTED_CLIENT_VERSION_MAX=

# 前端只暴露 VITE_ 前缀字段，禁止放入密钥。 / Only VITE_ fields reach the frontend; never put secrets in them.
# 开发代理目标；API 基础地址在构建时固定，修改后需重建。
# Dev proxy target; the API base URL is fixed at build time and requires a rebuild to change.
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_API_BASE_URL=/api
